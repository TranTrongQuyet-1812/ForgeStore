datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector", schema: "extensions")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// =============================================================
// BỘ ENUM ĐỊNH DANH THUẦN VIỆT
// =============================================================

enum VaiTro {
  NGUOI_DUNG
  QUAN_TRI_VIEN
}

enum LoaiThietBi {
  MAY_TINH_WINDOWS
  DIEN_THOAI_ANDROID
  KHAC
}

enum NenTangHoTro {
  ANDROID
  WINDOWS
  DA_NEN_TANG
}

enum MucDoUyTin {
  AN_TOAN_CAO     // Trust score 80 - 100
  CAN_LUU_Y       // Trust score 60 - 79
  CANH_BAO_RUI_RO // Trust score < 60
}

enum DinhDangTep {
  APK
  EXE
  MSI
  ZIP_PORTABLE
  KHAC
}

enum KienTrucChip {
  ARM64_V8A      // Android 64-bit hiện đại (Pixel, Galaxy, Xiaomi...)
  ARMEABI_V7A    // Android 32-bit đời cũ
  X86_64         // Windows PC Intel/AMD hoặc Android Emulator
  X86            // Windows PC 32-bit
  DUNG_CHUNG     // Universal APK chạy trên mọi kiến trúc
  KHONG_XAC_DINH
}

enum TrangThaiNapRepo {
  THANH_CONG
  LINK_KHONG_HOP_LE
  KHONG_CO_RELEASE
  KHONG_CO_FILE_CAI_DAT
  THAT_BAI
}

enum TrangThaiDichReadme {
  DANG_DICH
  HOAN_TAT
  THAT_BAI
  DA_CU
}

enum TrangThaiUngVienRepo {
  CHO_SANG_LOC
  BI_LOAI
  DA_NAP
}

enum LyDoLoaiUngVien {
  KHONG_CO_BAN_PHAT_HANH
  KHONG_CO_FILE_CAI
  CHI_CO_CAI_CLI
  DA_LUU_TRU
  GIAY_PHEP_KHONG_MO
  LOI_KHI_SANG_LOC
  // P3B-06.4: mã của bộ lọc dùng chung (bo-loc-nap-repo.util). Không có GIAY_PHEP_CAN_DUYET vì D-36 bỏ duyệt tay giấy phép.
  IT_SAO
  LA_FORK
  KHONG_CON_CAP_NHAT
  TRONG_DANH_SACH_CHAN
}

// =============================================================
// 11 BẢNG DỮ LIỆU THUẦN VIỆT
// =============================================================

// -------------------------------------------------------------
// BẢNG 1: NGƯỜI DÙNG (USERS)
// -------------------------------------------------------------
model NguoiDung {
  maNguoiDung       String            @id @default(uuid()) @map("ma_nguoi_dung") @db.Uuid
  maDinhDanhGithub  String?           @unique @map("ma_dinh_danh_github")
  maDinhDanhGoogle  String?           @unique @map("ma_dinh_danh_google")
  tenDangNhap       String            @map("ten_dang_nhap")
  tenHienThi        String?           @map("ten_hien_thi")
  thuDienTu         String?           @map("thu_dien_tu")
  duongDanAvatar    String?           @map("duong_dan_avatar")
  vaiTro            VaiTro            @default(NGUOI_DUNG) @map("vai_tro")
  ngayTao           DateTime          @default(now()) @map("ngay_tao")
  ngayCapNhat       DateTime          @updatedAt @map("ngay_cap_nhat")

  // Quan hệ nghiệp vụ
  danhSachThietBi   ThietBi[]
  danhSachPhien     PhienDangNhap[]
  danhSachYeuThich  KhoYeuThich[]
  danhSachDaCai     UngDungDaCai[]
  danhSachDanhGia   DanhGiaUngDung[]
  nhatKyNapRepo     NhatKyNapRepo[]

  @@map("nguoi_dung")
}

// -------------------------------------------------------------
// BẢNG 2: THIẾT BỊ VẬT LÝ (DEVICES) - TÁCH RỜI KHỎI SESSION
// -------------------------------------------------------------
model ThietBi {
  maThietBi         String            @id @default(uuid()) @map("ma_thiet_bi") @db.Uuid
  maNguoiDung       String            @map("ma_nguoi_dung") @db.Uuid
  dinhDanhPhanCung  String            @map("dinh_danh_phan_cung") // Hardware Fingerprint (UNIQUE theo maNguoiDung - D-02)
  tenThietBi        String            @map("ten_thiet_bi") // VD: "Pixel 7 Pro", "Laptop Dell"
  loaiThietBi       LoaiThietBi       @default(KHAC) @map("loai_thiet_bi")
  ngayDangKy        DateTime          @default(now()) @map("ngay_dang_ky")
  hoatDongLanCuoi   DateTime          @updatedAt @map("hoat_dong_lan_cuoi")

  nguoiDung         NguoiDung         @relation(fields: [maNguoiDung], references: [maNguoiDung], onDelete: Cascade)
  danhSachPhien     PhienDangNhap[]
  danhSachDaCai     UngDungDaCai[]

  @@unique([maNguoiDung, dinhDanhPhanCung])
  @@index([maNguoiDung])
  @@map("thiet_bi")
}

// -------------------------------------------------------------
// BẢNG 3: PHIÊN ĐĂNG NHẬP & TOKEN (USER SESSIONS)
// -------------------------------------------------------------
model PhienDangNhap {
  maPhien           String            @id @default(uuid()) @map("ma_phien") @db.Uuid
  maNguoiDung       String            @map("ma_nguoi_dung") @db.Uuid
  maThietBi            String            @map("ma_thiet_bi") @db.Uuid
  chuoiMaHoaToken      String            @map("chuoi_ma_hoa_token")
  chuoiMaHoaTokenCu    String?           @map("chuoi_ma_hoa_token_cu")
  thoiGianXoayVongCuoi DateTime?         @map("thoi_gian_xoay_vong_cuoi")
  diaChiIp             String?           @map("dia_chi_ip")
  thoiGianHetHan    DateTime          @map("thoi_gian_het_han")
  ngayTao           DateTime          @default(now()) @map("ngay_tao")

  nguoiDung         NguoiDung         @relation(fields: [maNguoiDung], references: [maNguoiDung], onDelete: Cascade)
  thietBi           ThietBi           @relation(fields: [maThietBi], references: [maThietBi], onDelete: Cascade)

  @@index([maNguoiDung])
  @@index([maThietBi])
  @@map("phien_dang_nhap")
}

// -------------------------------------------------------------
// BẢNG 4: ỨNG DỤNG TRONG STORE (APPLICATIONS)
// -------------------------------------------------------------
model UngDung {
  maUngDung         String            @id @default(uuid()) @map("ma_ung_dung") @db.Uuid
  tenRepoDayDu      String            @unique @map("ten_repo_day_du")
  chuSoHuu          String            @map("chu_so_huu")
  tenKhoChua        String            @map("ten_kho_chua")
  duongDanGithub    String            @map("duong_dan_github")
  moTaGocTiengAnh   String?           @map("mo_ta_goc_tieng_anh") @db.Text
  duongDanIcon      String?           @map("duong_dan_icon")
  soSaoGithub       Int               @default(0) @map("so_sao_github")
  soLuotFork        Int               @default(0) @map("so_luot_fork")
  loaiGiayPhep      String?           @map("loai_giay_phep")
  ngonNguChinh      String?           @map("ngon_ngu_chinh")
  danhSachChuDe     String[]          @default([]) @map("danh_sach_chu_de")
  danhMucChinh      String            @default("Tiện ích hệ thống") @map("danh_muc_chinh")
  nenTangHoTro      NenTangHoTro      @default(DA_NEN_TANG) @map("nen_tang_ho_tro")
  duocNoiBat        Boolean           @default(false) @map("duoc_noi_bat")
  daXacMinh         Boolean           @default(false) @map("da_xac_minh")
  tenGoiAndroid     String?           @map("ten_goi_android") // Package name Android (VD: org.videolan.vlc - D-13)
  trangThai         String            @default("HOAT_DONG") @map("trang_thai")
  daLuuTru          Boolean           @default(false) @map("da_luu_tru")

  // Bản dịch mô tả (D-17)
  moTaVi            String?           @map("mo_ta_vi") @db.Text
  maBamMoTa         String?           @map("ma_bam_mo_ta")

  // Cột tính sẵn (D-19)
  diemThinhHanh     Float             @default(0) @map("diem_thinh_hanh")
  banMoiNhatWindows String?           @map("ban_moi_nhat_windows")
  banMoiNhatAndroid String?           @map("ban_moi_nhat_android")
  dinhDangCoSan     DinhDangTep[]     @default([]) @map("dinh_dang_co_san")
  kienTrucCoSan     KienTrucChip[]    @default([]) @map("kien_truc_co_san")

  // Phát hiện thay đổi (D-18)
  pushedAt          DateTime?         @map("pushed_at")
  readmeSha         String?           @map("readme_sha")
  etagRepo          String?           @map("etag_repo")
  etagReleases      String?           @map("etag_releases")
  etagReadme        String?           @map("etag_readme")
  lanKiemTiepTheo   DateTime?         @map("lan_kiem_tiep_theo")
  mucDoNong         String            @default("BINH_THUONG") @map("muc_do_nong")

  dongBoLanCuoi     DateTime          @default(now()) @map("dong_bo_lan_cuoi")
  ngayTao           DateTime          @default(now()) @map("ngay_tao")
  ngayCapNhat       DateTime          @updatedAt @map("ngay_cap_nhat")

  // Quan hệ nghiệp vụ
  phanTichAI        PhanTichAI?
  danhSachPhatHanh  BanPhatHanh[]
  danhSachBanDichReadme BanDichReadme[]
  danhSachYeuThich  KhoYeuThich[]
  danhSachDaCai     UngDungDaCai[]
  danhSachDanhGia   DanhGiaUngDung[]
  nhatKyNapRepo     NhatKyNapRepo[]

  @@index([danhMucChinh, soSaoGithub(sort: Desc)])
  @@index([nenTangHoTro, duocNoiBat])
  @@index([soSaoGithub(sort: Desc)])
  @@index([tenGoiAndroid])
  @@index([diemThinhHanh(sort: Desc)])
  @@index([nenTangHoTro, danhMucChinh, diemThinhHanh(sort: Desc)])
  @@index([trangThai, lanKiemTiepTheo])
  @@map("ung_dung")
}

// -------------------------------------------------------------
// BẢNG 5: BỘ NÃO PHÂN TÍCH AI & VECTOR SEARCH (DUAL-AI)
// -------------------------------------------------------------
model PhanTichAI {
  maPhanTich          String          @id @default(uuid()) @map("ma_phan_tich") @db.Uuid
  maUngDung           String          @unique @map("ma_ung_dung") @db.Uuid
  khauHieuTiengViet   String          @map("khau_hieu_tieng_viet") // Gemini Slogan (lấy từ moTaVi - D-17)
  tomTatTinhNangVi    String?         @map("tom_tat_tinh_nang_vi") @db.Text // Không dùng nữa (D-17) - giữ nguyên dữ liệu cũ
  diemUyTin           Int             @default(80) @map("diem_uy_tin") // Chỉ bộ luật (0 - 100), P2-70
  mucDoAnToan         MucDoUyTin      @default(AN_TOAN_CAO) @map("muc_do_an_toan") // Khớp logic: 80 thuộc AN_TOAN_CAO
  soLanThuLai         Int                  @default(0) @map("so_lan_thu_lai") // Đếm số lần job thử tóm tắt lại (tối đa 3 lần)
  yeuToRuiRo          Json                 @default("[]") @map("yeu_to_rui_ro")
  quyenHanDaKiemTra   Json            @default("[]") @map("quyen_han_da_kiem_tra")
  huongDanCaiDat      Json?           @map("huong_dan_cai_dat") // Hướng dẫn cài đặt qua dòng lệnh CLI (Giai đoạn 3)
  
  // Vector 768 chiều phục vụ tìm kiếm ý định tự nhiên với PostgreSQL pgvector
  vectorNguNghia      Unsupported("vector(768)")? @map("vector_ngu_nghia")
  // P3B-28.3: vector Gemini Embedding 2, cột riêng, không so sánh chéo với vector_ngu_nghia (D-33)
  vectorNguNghiaV2    Unsupported("vector(768)")? @map("vector_ngu_nghia_v2")
  // P3B-09.3: mã băm văn bản đã dùng sinh vector; lệch với văn bản hiện tại thì job 2:00 sinh lại
  maBamVanBanVector   String?         @map("ma_bam_van_ban_vector")
  moHinhTomTat        String?         @map("mo_hinh_tom_tat") // D-15: Gemini / NVIDIA NIM / DU_PHONG (không dùng nữa - D-17)
  thoiGianPhanTich    DateTime        @default(now()) @map("thoi_gian_phan_tich")
  ngayTao             DateTime        @default(now()) @map("ngay_tao")
  ngayCapNhat         DateTime        @updatedAt @map("ngay_cap_nhat")


  ungDung             UngDung         @relation(fields: [maUngDung], references: [maUngDung], onDelete: Cascade)

  @@map("phan_tich_ai")
}

// -------------------------------------------------------------
// BẢNG 6: BẢN PHÁT HÀNH (RELEASES)
// -------------------------------------------------------------
model BanPhatHanh {
  maPhatHanh          String          @id @default(uuid()) @map("ma_phat_hanh") @db.Uuid
  maUngDung           String          @map("ma_ung_dung") @db.Uuid
  maReleaseGithub     BigInt?         @map("ma_release_github")
  tenPhienBan         String          @map("ten_phien_ban") // VD: "v1.2.4"
  tieuDePhatHanh      String?         @map("tieu_de_phat_hanh")
  nhatKyThayDoiGoc    String?         @map("nhat_ky_thay_doi_goc") @db.Text
  nhatKyThayDoiVi     String?         @map("nhat_ky_thay_doi_vi") @db.Text // Changelog dịch tiếng Việt (D-17)
  tomTatNangCapVi     String?         @map("tom_tat_nang_cap_vi") @db.Text // Gemini tóm tắt cập nhật (không dùng nữa - D-17)
  laBanThuNghiem      Boolean         @default(false) @map("la_ban_thu_nghiem")
  ngayPhatHanh        DateTime        @map("ngay_phat_hanh")
  ngayTao             DateTime        @default(now()) @map("ngay_tao")

  ungDung             UngDung         @relation(fields: [maUngDung], references: [maUngDung], onDelete: Cascade)
  danhSachTepCaiDat   TepCaiDat[]

  @@unique([maUngDung, tenPhienBan])
  @@index([maUngDung, ngayPhatHanh(sort: Desc)])
  @@map("ban_phat_hanh")
}

// -------------------------------------------------------------
// BẢNG 7: TỆP CÀI ĐẶT & KIẾN TRÚC CHIP (RELEASE ASSETS)
// -------------------------------------------------------------
model TepCaiDat {
  maTep             String            @id @default(uuid()) @map("ma_tep") @db.Uuid
  maPhatHanh        String            @map("ma_phat_hanh") @db.Uuid
  tenTep            String            @map("ten_tep")
  duongDanTaiVe     String            @map("duong_dan_tai_ve")
  dungLuongBytes    BigInt            @default(0) @map("dung_luong_bytes")
  dinhDangTep       DinhDangTep       @default(KHAC) @map("dinh_dang_tep")
  kienTrucChip      KienTrucChip      @default(KHONG_XAC_DINH) @map("kien_truc_chip") // Luật chọn tệp theo ABI đọc trường này
  maBamSha256       String?           @map("ma_bam_sha256")
  soLuotTai         Int               @default(0) @map("so_luot_tai")
  ngayTao           DateTime          @default(now()) @map("ngay_tao")

  banPhatHanh       BanPhatHanh       @relation(fields: [maPhatHanh], references: [maPhatHanh], onDelete: Cascade)
  danhSachDaCai     UngDungDaCai[]

  @@unique([maPhatHanh, tenTep])
  @@index([maPhatHanh, dinhDangTep, kienTrucChip])
  @@map("tep_cai_dat")
}

// -------------------------------------------------------------
// BẢNG 8: KHO YÊU THÍCH ĐỒNG BỘ ĐÁM MÂY (USER FAVORITES)
// -------------------------------------------------------------
model KhoYeuThich {
  maYeuThich        String            @id @default(uuid()) @map("ma_yeu_thich") @db.Uuid
  maNguoiDung       String            @map("ma_nguoi_dung") @db.Uuid
  maUngDung         String            @map("ma_ung_dung") @db.Uuid
  thietBiThem       String            @default("MAY_TINH") @map("thiet_bi_them")
  ngayThem          DateTime          @default(now()) @map("ngay_them")

  nguoiDung         NguoiDung         @relation(fields: [maNguoiDung], references: [maNguoiDung], onDelete: Cascade)
  ungDung           UngDung           @relation(fields: [maUngDung], references: [maUngDung], onDelete: Cascade)

  @@unique([maNguoiDung, maUngDung])
  @@index([maNguoiDung, ngayThem(sort: Desc)])
  @@index([maUngDung])
  @@map("kho_yeu_thich")
}

// -------------------------------------------------------------
// BẢNG 9: THEO DÕI CÀI ĐẶT & CẬP NHẬT TỰ ĐỘNG (INSTALLED APPS)
// -------------------------------------------------------------
model UngDungDaCai {
  maBanGhi          String            @id @default(uuid()) @map("ma_ban_ghi") @db.Uuid
  maNguoiDung       String            @map("ma_nguoi_dung") @db.Uuid
  maUngDung         String            @map("ma_ung_dung") @db.Uuid
  maThietBi         String            @map("ma_thiet_bi") @db.Uuid // Gắn với Thiết bị vật lý
  phienBanHienTai   String            @map("phien_ban_hien_tai") // Bản đang chạy trên máy
  maTepDaCai        String?           @map("ma_tep_da_cai") @db.Uuid
  duongDanThuMuc    String?           @map("duong_dan_thu_muc") // Cho Windows Portable
  khoaRegistry      String?           @map("khoa_registry") // Khóa Registry Windows lưu thông tin gỡ cài đặt (A4)
  tenHienThiRegistry String?          @map("ten_hien_thi_registry") // Tên hiển thị Registry Windows (DisplayName)
  trinhQuanLyGoi    String?           @map("trinh_quan_ly_goi") // winget, scoop, npm, pip, docker (P3B-16)
  tenGoiCli         String?           @map("ten_goi_cli") // Tên gói đã cài qua CLI (P3B-16)
  lenhGoCli         String?           @map("lenh_go_cli") // Lệnh gỡ từ manifest (P3B-16)
  trangThaiXacNhan  String?           @default("DA_XAC_NHAN") @map("trang_thai_xac_nhan") // CHO_XAC_NHAN | DA_XAC_NHAN (P3B-16)
  thoiGianHetHan    DateTime?         @map("thoi_gian_het_han") // Tự hết hạn sau 24h nếu CHO_XAC_NHAN (P3B-16)
  ngayCaiDat        DateTime          @default(now()) @map("ngay_cai_dat")
  ngayCapNhatCuoi   DateTime          @updatedAt @map("ngay_cap_nhat_cuoi")

  nguoiDung         NguoiDung         @relation(fields: [maNguoiDung], references: [maNguoiDung], onDelete: Cascade)
  ungDung           UngDung           @relation(fields: [maUngDung], references: [maUngDung], onDelete: Cascade)
  thietBi           ThietBi           @relation(fields: [maThietBi], references: [maThietBi], onDelete: Cascade)
  tepDaCai          TepCaiDat?        @relation(fields: [maTepDaCai], references: [maTep], onDelete: SetNull)

  @@unique([maThietBi, maUngDung])
  @@index([maThietBi])
  @@index([maNguoiDung])
  @@index([maUngDung])
  @@index([maTepDaCai])
  @@map("ung_dung_da_cai")
}

// -------------------------------------------------------------
// BẢNG 10: ĐÁNH GIÁ & PHẢN HỒI CỘNG ĐỒNG (APP REVIEWS)
// -------------------------------------------------------------
model DanhGiaUngDung {
  maDanhGia         String            @id @default(uuid()) @map("ma_danh_gia") @db.Uuid
  maNguoiDung       String            @map("ma_nguoi_dung") @db.Uuid
  maUngDung         String            @map("ma_ung_dung") @db.Uuid
  soSao             Int               @map("so_sao") // 1 - 5 sao
  tieuDe            String?           @map("tieu_de")
  noiDungNhanXet    String            @db.Text @map("noi_dung_nhan_xet")
  phienBanDanhGia   String            @map("phien_ban_danh_gia") // Đánh giá trên bản v1.2 hay v1.3
  thietBiDanhGia    String            @map("thiet_bi_danh_gia") // "Windows 11" hoặc "Pixel 7"
  soLuotHuuIch      Int               @default(0) @map("so_luot_huu_ich")
  ngayDanhGia       DateTime          @default(now()) @map("ngay_danh_gia")
  ngayCapNhat       DateTime          @updatedAt @map("ngay_cap_nhat")

  nguoiDung         NguoiDung         @relation(fields: [maNguoiDung], references: [maNguoiDung], onDelete: Cascade)
  ungDung           UngDung           @relation(fields: [maUngDung], references: [maUngDung], onDelete: Cascade)

  @@unique([maNguoiDung, maUngDung, phienBanDanhGia])
  @@index([maUngDung, soSao(sort: Desc)])
  @@map("danh_gia_ung_dung")
}

// -------------------------------------------------------------
// BẢNG 11: NHẬT KÝ NẠP REPO TÙY CHỌN (MODULE 6 INGESTION)
// -------------------------------------------------------------
model NhatKyNapRepo {
  maNhatKy            String          @id @default(uuid()) @map("ma_nhat_ky") @db.Uuid
  maNguoiDungYeuCau   String?         @map("ma_nguoi_dung_yeu_cau") @db.Uuid
  duongDanRepoNhap    String          @map("duong_dan_repo_nhap")
  trangThai           TrangThaiNapRepo @default(THANH_CONG) @map("trang_thai")
  thongBaoLoi         String?         @db.Text @map("thong_bao_loi")
  maUngDungTaoRa      String?         @map("ma_ung_dung_tao_ra") @db.Uuid
  ngayYeuCau          DateTime        @default(now()) @map("ngay_yeu_cau")

  nguoiDungYeuCau     NguoiDung?      @relation(fields: [maNguoiDungYeuCau], references: [maNguoiDung], onDelete: SetNull)
  ungDungTaoRa        UngDung?        @relation(fields: [maUngDungTaoRa], references: [maUngDung], onDelete: SetNull)

  @@index([maNguoiDungYeuCau])
  @@index([maUngDungTaoRa])
  @@map("nhat_ky_nap_repo")
}

// -------------------------------------------------------------
// BẢNG 12: BẢN DỊCH README (APP README TRANSLATIONS - P3B)
// -------------------------------------------------------------
model BanDichReadme {
  maBanDich         String              @id @default(uuid()) @map("ma_ban_dich") @db.Uuid
  maUngDung         String              @map("ma_ung_dung") @db.Uuid
  ngonNgu           String              @default("vi") @map("ngon_ngu")
  readmeSha         String              @map("readme_sha")
  noiDungDich       String              @map("noi_dung_dich") @db.Text
  moHinhDich        String              @map("mo_hinh_dich")
  trangThai         TrangThaiDichReadme @default(HOAN_TAT) @map("trang_thai")
  thoiGianDich      DateTime            @default(now()) @map("thoi_gian_dich")

  ungDung           UngDung             @relation(fields: [maUngDung], references: [maUngDung], onDelete: Cascade)

  @@unique([maUngDung, ngonNgu])
  @@map("ban_dich_readme")
}

// -------------------------------------------------------------
// BẢNG 13: BỘ NHỚ DỊCH DÙNG CHUNG (SHARED TRANSLATION MEMORY - P3B)
// -------------------------------------------------------------
model BoNhoDichChung {
  maBam             String              @map("ma_bam") // MD5 / SHA-256 đoạn gốc
  ngonNgu           String              @default("vi") @map("ngon_ngu")
  doanGoc           String              @map("doan_goc") @db.Text
  doanDich          String              @map("doan_dich") @db.Text
  moHinhDich        String              @map("mo_hinh_dich")
  ngayTao           DateTime            @default(now()) @map("ngay_tao")

  @@id([maBam, ngonNgu])
  @@map("bo_nho_dich_chung")
}

// -------------------------------------------------------------
// BẢNG 14: HÀNG ĐỢI ỨNG VIÊN REPO (INGESTION QUEUE - P3B)
// -------------------------------------------------------------
model UngVienRepo {
  maUngVien         String               @id @default(uuid()) @map("ma_ung_vien") @db.Uuid
  tenRepoDayDu      String               @unique @map("ten_repo_day_du")
  nguonKhamPha      String               @map("nguon_kham_pha")
  trangThai         TrangThaiUngVienRepo @default(CHO_SANG_LOC) @map("trang_thai")
  lyDoLoai          LyDoLoaiUngVien?     @map("ly_do_loai")
  // P3B-06.1: 1 = Trending, 2 = nhiều sao, 3 = đáng chú ý; hàng chờ lấy số nhỏ trước
  doUuTien          Int                  @default(2) @map("do_uu_tien")
  // P3B-06.7: số lần gặp lỗi tạm thời; quá 3 lần mới chuyển sang lỗi để không chặn đầu hàng chờ
  soLanThu          Int                  @default(0) @map("so_lan_thu")
  ngayTao           DateTime             @default(now()) @map("ngay_tao")
  ngayCapNhat       DateTime             @updatedAt @map("ngay_cap_nhat")

  @@index([trangThai, ngayTao(sort: Asc)])
  @@index([trangThai, doUuTien, ngayTao(sort: Asc)])
  @@map("ung_vien_repo")
}

