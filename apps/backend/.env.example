# ==============================================================================
# ForgeStore - Backend Environment Variables Example
# Copy this file to .env and fill in the values
# ==============================================================================

# Server Port & Environment
PORT=3000
NODE_ENV="development"

# Database (PostgreSQL 17 + pgvector Self-Hosted on Dokploy)
DATABASE_URL="postgresql://forgestore:[PASSWORD]@192.168.0.118:5432/forgestore?connection_limit=10"
DIRECT_URL="postgresql://forgestore:[PASSWORD]@192.168.0.118:5432/forgestore"

# Redis Cache (Dokploy / Local)
REDIS_URL="redis://localhost:6379"

# GitHub OAuth App (Dev)
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_CALLBACK_URL="http://localhost:3000/api/v1/xac-thuc/callback"

# GitHub Personal Access Token (Read-only public repos)
GITHUB_TOKEN="your_github_personal_access_token"

# Google OAuth (Optional)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/v1/xac-thuc/google/callback"

# Google Gemini API Key (System 2 LLM & Embeddings - D-10)
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# TypeSafe AI (Jev System 1) API Key & Switch
TYPESAFE_API_KEY="your_typesafe_api_key"
JEV_ENABLED="true"

# NVIDIA NIM (Fallback LLM - D-15)
NVIDIA_API_KEY="your_nvidia_api_key"
NVIDIA_NIM_MODEL="meta/llama-3.1-70b-instruct"

# NVIDIA NIM dùng để DỊCH (P3B-05.6), tách riêng khỏi NVIDIA_NIM_MODEL ở trên
NVIDIA_TRANSLATE_MODEL="poolside/laguna-xs-2.1"

# Security & App Tokens (Zero-Token-on-URL flow - D-09)
JWT_ACCESS_SECRET="generate-a-secure-random-key-for-access-token"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
APP_DEEP_LINK_SCHEME="forgestore"

# Cloudflare Workers AI (Translation Provider 3 - D-24)
CLOUDFLARE_TRANSLATE_URL="https://forgestore-translate.<your-account>.workers.dev"
CLOUDFLARE_TRANSLATE_SECRET="your_translate_secret_32bytes_hex"

# Groq (goi mien phi) - nha dich thu 4
GROQ_API_KEY="your_groq_api_key"
GROQ_MODEL="qwen/qwen3.8-27b"

# Day chuyen nap repo quy mo lon & Hang doi dich (P3B-06, P3B-05.4)
INGESTION_ENABLED="false"
INGESTION_BATCH_SIZE=30
INGESTION_DAILY_README_BUDGET=50
