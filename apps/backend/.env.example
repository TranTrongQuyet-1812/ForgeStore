# ==============================================================================
# ForgeStore - Backend Environment Variables Example
# Copy this file to .env and fill in the values
# ==============================================================================

# Server Port & Environment
PORT=3000
NODE_ENV="development"

# Database (Supabase PostgreSQL + pgvector)
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Redis Cache (Dokploy / Local)
REDIS_URL="redis://localhost:6379"

# GitHub OAuth App (Dev)
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_CALLBACK_URL="http://localhost:3000/api/v1/auth/callback"

# GitHub Personal Access Token (Read-only public repos)
GITHUB_TOKEN="your_github_personal_access_token"

# Google OAuth (Optional)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/v1/auth/google/callback"

# Google Gemini API Key (System 2 LLM & Embeddings)
GEMINI_API_KEY="your_gemini_api_key"

# TypeSafe AI (Jev System 1) API Key & Switch
TYPESAFE_API_KEY="your_typesafe_api_key"
JEV_ENABLED="true"

# NVIDIA NIM (Fallback LLM - D-15)
NVIDIA_API_KEY="your_nvidia_api_key"
NVIDIA_NIM_MODEL="meta/llama-3.1-70b-instruct"

# Security & App Tokens (Zero-Token-on-URL flow - D-09)
JWT_ACCESS_SECRET="generate-a-secure-random-key-for-access-token"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
APP_DEEP_LINK_SCHEME="forgestore"
