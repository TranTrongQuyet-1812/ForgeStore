{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "ForgeStore",
  "version": "0.1.3",
  "identifier": "vn.edu.lhu.forgestore",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ForgeStore",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api-forgestore.tranquyet.id.vn http://localhost:3000 http://127.0.0.1:3000 http://localhost:1420 http://127.0.0.1:1420 https://api.github.com; img-src 'self' https: data:; script-src 'self'; style-src 'self' 'unsafe-inline';",
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["forgestore"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyNEI3NDM0RDI1MkVDMTkKUldRWjdGTFNOSFJMNGtzR0tldlRFQklrYmlFSFhqWW8ybEg1ZjFLU2Z6M0FVLzRvWEVHcjdpTTEK",
      "endpoints": [
        "https://github.com/TranTrongQuyet-1812/ForgeStore_Project/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "ForgeStore Team"
  }
}
