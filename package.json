{
  "name": "forgestore-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "ForgeStore - Open-Source App Store Ecosystem",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive --filter \"./packages/*\" run build",
    "build:packages": "pnpm --recursive --filter \"./packages/*\" run build",
    "build:backend": "pnpm --filter @forgestore/backend run build",
    "build:desktop": "pnpm --filter @forgestore/desktop run build",
    "build:mobile": "pnpm --filter @forgestore/mobile run build",
    "dev": "pnpm --parallel run dev",
    "dev:backend": "pnpm --filter @forgestore/backend run dev",
    "dev:desktop": "pnpm --filter @forgestore/desktop run dev",
    "dev:mobile": "pnpm --filter @forgestore/mobile run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm --recursive run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "pnpm --recursive run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
