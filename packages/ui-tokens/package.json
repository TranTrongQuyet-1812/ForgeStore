{
  "name": "@forgestore/ui-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens, color palettes and Tailwind preset for ForgeStore UI",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./preset": {
      "import": {
        "types": "./dist/tailwind-preset.d.mts",
        "default": "./dist/tailwind-preset.mjs"
      },
      "require": {
        "types": "./dist/tailwind-preset.d.ts",
        "default": "./dist/tailwind-preset.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@forgestore/types": "workspace:*"
  }
}
